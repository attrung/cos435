# ── Build artifacts ────────────────────────────────────────────
cpp-implementation/build/
cpp-implementation/third_party/
cpp-implementation/CMakeCache.txt
cpp-implementation/CMakeFiles/

# ── Model weights, checkpoints, buffers (regenerable) ──────────
# Note: paper-relevant snapshots live at top-level weights/ and ARE tracked.
cpp-implementation/final_weights
cpp-implementation/final_weights_*
cpp-implementation/eval_weights_*
cpp-implementation/snapshots/
cpp-implementation/checkpoints

# ── Training scratch (regenerable) ─────────────────────────────
# Note: paper-relevant logs/CSVs live at top-level results/ and ARE tracked.
cpp-implementation/logs/
cpp-implementation/results/

# ── Legacy python impl scratch ────────────────────────────────
legacy/python-leduc-impl/results/checkpoints/
legacy/python-leduc-impl/results/.progress/
legacy/python-leduc-impl/results/**/*.log
legacy/python-leduc-impl/results/**/*.jsonl
legacy/python-leduc-impl/results/**/*.npy
legacy/python-leduc-impl/results/**/*.csv

# ── Stale conversation / scratch dumps ─────────────────────────
cpp-implementation/*.txt

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[co]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ── Editor / OS ────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
*~

# ── Claude Code runtime ────────────────────────────────────────
.claude/scheduled_tasks.lock
.claude/*.local.json
